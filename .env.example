# URL publique du site sur Vercel (utilisee pour le lien cliquable et le QR Code de partage)
NEXT_PUBLIC_SITE_URL=https://coincheirb.vercel.app

# Variables publiques autorisees cote navigateur (cle anon uniquement - optionnel si repli serveur)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Variables strictement serveur (ne jamais prefixer par NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SESSION_HMAC_SECRET=replace-with-at-least-64-random-hex-characters-secret

# Authentification Administrateur Multi-Facteurs (/admin)
# 1. Identifiant Bureau (defaut: bureau-coincheirb)
ADMIN_IDENTIFIER=bureau-coincheirb
# 2. Empreinte scrypt du mot de passe maitre (generee avec: npm run hash:password -- "VotreMotDePasseFort")
ADMIN_BOOTSTRAP_PASSWORD_HASH=
# 3. Code PIN de securite Bureau a 6 chiffres (defaut: 331830)
ADMIN_SECURITY_PIN=331830
